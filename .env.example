# Copy to .env.local for development. In production set these in Vercel / Netlify.
# Every variable is optional: anything left empty is simply not shown or not enabled.

# Public URL of the site (canonical links, Open Graph, sitemap). No trailing slash.
# On Vercel this is optional: it falls back to the project's production domain.
# Set it once you connect a custom domain, e.g. https://aio9.com
NEXT_PUBLIC_SITE_URL=

# Public contact channels. They are only rendered when set.
NEXT_PUBLIC_CONTACT_EMAIL=
# Digits only, with country code (example format: 50200000000)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Contact form delivery (server only). Configure ONE of the two options. ---
# Without either, POST /api/contact answers 503 and the form tells the visitor
# the inquiry was not sent.

# Option 1 — email through Resend (https://resend.com)
RESEND_API_KEY=
# Inbox that receives inquiries
CONTACT_TO_EMAIL=
# Verified sender in Resend, e.g. "AIO9 <web@your-domain.com>"
CONTACT_FROM_EMAIL=

# Option 2 — JSON webhook (CRM, Slack, n8n, Zapier, Make…)
CONTACT_WEBHOOK_URL=
